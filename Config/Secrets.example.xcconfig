// Copia questo file in Config/Secrets.xcconfig e compila i valori.
// Config/Secrets.xcconfig non viene versionato (vedi .gitignore).
//
// Nota: nei file .xcconfig la sequenza // apre un commento.
// Per scrivere un URL usa il trucco /$()/ come negli esempi.

// URL principale del backend, es. https:/$()/api.esempio.com
SINFONIA_API_BASE_URL =

// Elenco di URL di riserva separati da virgola (facoltativo)
SINFONIA_API_BACKUP_URLS =

// Pin dei certificati per il certificate pinning, separati da virgola (facoltativo)
SINFONIA_API_PINS =
